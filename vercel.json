{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/seo-analyse.ts": {
      "maxDuration": 45
    }
  },
  "redirects": [
    { "source": "/leistungen/seo", "destination": "/seo-agentur/", "permanent": true },
    { "source": "/leistungen/seo/", "destination": "/seo-agentur/", "permanent": true },
    { "source": "/services/seo", "destination": "/seo-agentur/", "permanent": true },
    { "source": "/services/seo/", "destination": "/seo-agentur/", "permanent": true },
    { "source": "/sitemap-index.xml", "destination": "/sitemap.xml", "permanent": true }
  ],
  "rewrites": [
    { "source": "/((?!api/|snapshot/).*)", "destination": "/index.html" }
  ]
}
